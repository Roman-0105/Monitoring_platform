# Скопируйте в .env и заполните реальными значениями (.env не коммитить).

MSSQL_SERVER=RAYWEBV04
MSSQL_DATABASE=GeoLocation
# Вариант А — SQL-логин (проще для старта):
MSSQL_USER=
MSSQL_PASSWORD=
# Вариант Б — Windows-аутентификация пула приложений (не задавайте USER/PASSWORD,
# оставьте пустыми — тогда используется встроенная Windows-аутентификация, если
# запускать под IIS через iisnode с пулом приложений с доступом к SQL Server).
MSSQL_TRUSTED_CONNECTION=false

# Порт, на котором слушает Express, когда сервер поднят напрямую (node src/index.js).
# Под iisnode порт не используется — IIS сам управляет процессом и передаёт stdin-сокет.
PORT=3000

# Путь к каталогу с файлами (фото/схемы/сканы/3D-модели) — тот же диск,
# что отдаёт IIS Virtual Directory на чтение; backend пишет сюда новые файлы.
FILES_ROOT=D:\JAM\Prod\GeoAdmin\static\files

# Публичный базовый URL, под которым Virtual Directory отдаёт FILES_ROOT
# (используется только для сборки ссылок в ответах API, сама раздача — целиком на IIS).
FILES_PUBLIC_BASE_URL=https://geoadmin.rggold.kz/static/files
