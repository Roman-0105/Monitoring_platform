<?xml version="1.0" encoding="utf-8"?>
<!--
  Конфигурация для хостинга под IIS через iisnode. Разместить рядом с
  src/index.js (в этой же папке server/) при деплое на RAYWEBV04.

  Обязательно на уровне сайта/приложения в IIS Manager (не здесь, а в
  настройках сайта — см. задачу "Настроить IIS" в плане):
    - Authentication: Windows Authentication = Enabled, Anonymous = Disabled.
    - Ограничение доступа по AD-группе (через NTFS-права на физический путь
      сайта или через Authorization Rules).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="src/index.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="geoadmin-server">
          <match url="/*" />
          <action type="Rewrite" url="src/index.js" />
        </rule>
      </rules>
    </rewrite>
    <!-- LOGON_USER должен передаваться Node-процессу как CGI-переменная —
         проверить фактическое имя заголовка при первом деплое (см.
         src/middleware/identity.js) и включить нужный флаг ниже, если
         потребуется явно прокидывать серверные переменные. -->
    <iisnode watchedFiles="web.config;*.js" nodeProcessCommandLine="node.exe" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" /> <!-- 50 MB, под загрузку сканов/фото -->
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
